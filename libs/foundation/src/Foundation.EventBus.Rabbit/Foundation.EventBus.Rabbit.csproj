<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        
        <!-- NuGet Package Configuration -->
        <PackageId>Foundation.EventBus.Rabbit</PackageId>
        <Title>Foundation.EventBus.Rabbit</Title>
        <Description>Foundation library providing RabbitMQ implementation for the event bus in modular applications.</Description>
        <PackageTags>foundation;event-bus;rabbitmq;messaging;modular</PackageTags>
    </PropertyGroup>

    <ItemGroup>
      <ProjectReference Include="..\Foundation.EventBus.Abstractions\Foundation.EventBus.Abstractions.csproj" />
      <ProjectReference Include="..\Foundation\Foundation.csproj" />
    </ItemGroup>

    <ItemGroup>
      <PackageReference Include="Microsoft.Extensions.Configuration.Binder" Version="10.0.10" />
      <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.10" />
      <PackageReference Include="Microsoft.Extensions.Options" Version="10.0.10" />
      <PackageReference Include="RabbitMQ.Client" Version="7.2.1" />
    </ItemGroup>

</Project>
