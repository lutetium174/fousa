<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        
        <!-- NuGet Package Configuration -->
        <PackageId>Foundation.DependencyInjection.Web</PackageId>
        <Title>Foundation.DependencyInjection.Web</Title>
        <Description>Foundation library providing ASP.NET Core Web-specific dependency injection extensions for modular applications.</Description>
        <PackageTags>foundation;dependency-injection;web;aspnetcore;module</PackageTags>
        <PackageReadmeFile>README.md</PackageReadmeFile>
        <DependencyGroupId>Foundation</DependencyGroupId>
    </PropertyGroup>

    <ItemGroup>
      <FrameworkReference Include="Microsoft.AspNetCore.App" />
    </ItemGroup>

    <ItemGroup>
      <ProjectReference Include="..\Foundation\Foundation.csproj" />
    </ItemGroup>

    <ItemGroup>
      <Content Include="README.md" PackagePath="" />
    </ItemGroup>

</Project>
