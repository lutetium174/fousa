{
  "name": "components",
  "sourceRoot": "libs/components",
  "projectType": "library",
  "tags": ["npm", "library", "solid-js", "components"],
  "targets": {
    "build": {
      "executor": "nx:run-script",
      "options": {
        "script": "build",
        "cwd": "{workspaceRoot}/libs/components"
      },
      "outputs": ["{workspaceRoot}/libs/components/dist"]
    },
    "dev": {
      "executor": "nx:run-script",
      "options": {
        "script": "dev",
        "cwd": "{workspaceRoot}/libs/components"
      }
    }
  }
}
