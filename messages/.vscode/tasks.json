{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "pnpm: dev",
      "type": "shell",
      "command": "pnpm",
      "args": ["dev"],
      "isBackground": true,
      "problemMatcher": [
        {
          "pattern": [
            {
              "regexp": "^([^\\s].*)$",
              "file": 1
            },
            {
              "regexp": "^\\s+(\\d+):(\\d+)\\s+(error|warning)\\s+(.*)$",
              "line": 1,
              "column": 2,
              "severity": 3,
              "message": 4
            }
          ],
          "background": {
            "activeOnStart": true,
            "beginsPattern": "^.*VITE.*ready in.*ms.*$",
            "endsPattern": "^.*error.*|^.*failed.*"
          }
        }
      ]
    }
  ]
}
