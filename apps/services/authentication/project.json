{
  "name": "authentication",
  "sourceRoot": "apps/services/authentication",
  "projectType": "application",
  "tags": ["dotnet", "application", "service"],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "command": "dotnet build fousa.sln --configuration Release",
        "cwd": "{workspaceRoot}/apps/services/authentication"
      },
      "configurations": {
        "Debug": {
          "command": "dotnet build fousa.sln --configuration Debug",
          "cwd": "{workspaceRoot}/apps/services/authentication"
        }
      },
      "outputs": ["{workspaceRoot}/apps/services/authentication/src/App/bin"]
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "dotnet test fousa.sln",
        "cwd": "{workspaceRoot}/apps/services/authentication"
      }
    },
    "run": {
      "executor": "nx:run-commands",
      "options": {
        "command": "dotnet run --project src/App/fousa.csproj",
        "cwd": "{workspaceRoot}/apps/services/authentication"
      },
      "dependsOn": ["build"]
    }
  }
}
